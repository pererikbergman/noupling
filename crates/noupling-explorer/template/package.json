{
  "name": "noupling-explorer-template",
  "version": "0.7.0",
  "private": true,
  "description": "Frontend template for the noupling Explorer report. Built to a single self-contained HTML file that the noupling-explorer Rust crate embeds and hydrates with the Data Contract.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && mv dist/index.html dist/explorer.html && rm -rf dist/samples",
    "preview": "vite preview",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mts",
    "test:e2e": "playwright test --project=chromium tests/e2e/smoke.spec.ts",
    "test:e2e:android": "playwright test --project=chromium tests/e2e/android.spec.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
