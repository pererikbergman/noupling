{
  "thresholds": {
    "score_green": 90.0,
    "score_yellow": 70.0,
    "critical_severity": 0.5,
    "minimum_severity": 0.2,
    "hotspot_fan_in": 10,
    "min_cohesion": 0.1
  },
  "ignore_patterns": [
    "**/.git/**",
    "**/target/**",
    "**/node_modules/**",
    "**/.noupling/**",
    "**/.agent/**",
    "**/build/**",
    "**/dist/**",
    "**/.gradle/**",
    "**/__pycache__/**",
    "**/.venv/**",
    "**/zig-cache/**",
    "**/zig-out/**",
    "**/generated/**",
    "**/.idea/**",
    "**/.vscode/**",
    "**/examples/**",
    "**/tests/**",
    "**/docs/**"
  ],
  "source_extensions": [
    "rs",
    "kt",
    "kts",
    "ts",
    "tsx",
    "swift",
    "cs",
    "go",
    "hs",
    "java",
    "js",
    "jsx",
    "py",
    "dart",
    "php",
    "rb",
    "zig"
  ],
  "dependency_rules": [
    {
      "from": "**/crates/noupling-core/**",
      "to": "**/crates/noupling-cli/**",
      "allow": false,
      "message": "noupling-core is the pure analysis library; it must not depend on the cli/reporter side."
    },
    {
      "from": "**/crates/noupling-core/**",
      "to": "**/crates/noupling-explorer/**",
      "allow": false,
      "message": "noupling-core must not depend on noupling-explorer."
    },
    {
      "from": "**/crates/noupling-explorer/**",
      "to": "**/crates/noupling-cli/**",
      "allow": false,
      "message": "noupling-explorer depends only on noupling-core, never on the cli or reporter siblings."
    }
  ],
  "layers": [
    { "name": "explorer", "pattern": "**/crates/noupling-explorer/**" },
    { "name": "reporter", "pattern": "**/crates/noupling-cli/src/reporter/**" },
    { "name": "commands", "pattern": "**/crates/noupling-cli/src/commands/**" },
    { "name": "scanner", "pattern": "**/crates/noupling-core/src/scanner/**" },
    { "name": "storage", "pattern": "**/crates/noupling-core/src/storage/**" },
    { "name": "analyzer", "pattern": "**/crates/noupling-core/src/analyzer/**" },
    { "name": "core", "pattern": "**/crates/noupling-core/src/core/**" },
    { "name": "settings", "pattern": "**/crates/noupling-core/src/settings.rs" }
  ],
  "allow_inline_suppression": true,
  "modules": []
}
